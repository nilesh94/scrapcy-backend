# ============================================================================
# SCRAPCY E-AUCTION - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - add it to .gitignore
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=oracle+oracledb://SCRAPCY_APP:your_password@your_host:1521/your_service_name

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=SCRAPCY E-Auction
APP_ENV=development  # development, staging, production
DEBUG=True
API_VERSION=v1

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-frontend.com

# ============================================================================
# SERVER URLS
# ============================================================================
# Backend URL (change when switching from Render to OCI)
BACKEND_URL=https://scrapcy-backend.onrender.com
FRONTEND_URL=https://scrapcy.com

# ============================================================================
# REDIS CONFIGURATION (for caching & real-time features)
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10
REDIS_CACHE_TTL=3600  # Cache TTL in seconds (1 hour)

# ============================================================================
# FILE STORAGE CONFIGURATION
# ============================================================================
STORAGE_PROVIDER=s3  # Options: s3, oci, local

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=scrapcy-uploads
AWS_S3_PUBLIC_URL=https://scrapcy-uploads.s3.ap-south-1.amazonaws.com

# OCI Object Storage Configuration (alternative to S3)
OCI_NAMESPACE=your-oci-namespace
OCI_BUCKET=scrapcy-uploads
OCI_REGION=ap-mumbai-1
OCI_COMPARTMENT_ID=your-compartment-id
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# Local Storage (for development)
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ============================================================================
# PAYMENT GATEWAY - RAZORPAY
# ============================================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_ENABLED=True

# Payment Settings
PAYMENT_CURRENCY=INR
PAYMENT_TIMEOUT_MINUTES=15

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
EMAIL_ENABLED=True
EMAIL_PROVIDER=sendgrid  # Options: sendgrid, ses, smtp

# SendGrid Configuration
SENDGRID_API_KEY=SG.your-sendgrid-api-key
EMAIL_FROM=noreply@scrapcy.com
EMAIL_FROM_NAME=SCRAPCY

# AWS SES Configuration (alternative)
AWS_SES_REGION=ap-south-1
AWS_SES_FROM_EMAIL=noreply@scrapcy.com

# SMTP Configuration (alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=True

# ============================================================================
# SMS CONFIGURATION
# ============================================================================
SMS_ENABLED=True
SMS_PROVIDER=msg91  # Options: msg91, twilio

# MSG91 Configuration
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=SCRPCY
MSG91_ROUTE=4  # 4 = Transactional, 1 = Promotional
MSG91_TEMPLATE_ID_OTP=your-template-id

# Twilio Configuration (alternative)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# OTP CONFIGURATION
# ============================================================================
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# ============================================================================
# GST VERIFICATION API
# ============================================================================
GST_VERIFICATION_ENABLED=True
GST_VERIFICATION_PROVIDER=karza  # Options: karza, signdesk
GST_API_KEY=your-gst-api-key
GST_API_URL=https://api.karza.in/v2/gst

# ============================================================================
# PAN VERIFICATION API
# ============================================================================
PAN_VERIFICATION_ENABLED=True
PAN_VERIFICATION_PROVIDER=karza
PAN_API_KEY=your-pan-api-key
PAN_API_URL=https://api.karza.in/v2/pan

# ============================================================================
# BACKGROUND SCHEDULER SETTINGS
# ============================================================================
SCHEDULER_ENABLED=True
AUCTION_CHECK_INTERVAL_SECONDS=30  # Check for closing auctions every 30 seconds
NOTIFICATION_BATCH_SIZE=100

# ============================================================================
# COMMISSION SETTINGS (defaults, can be overridden in DB)
# ============================================================================
DEFAULT_SELLER_COMMISSION_PERCENT=2.0
DEFAULT_BUYER_COMMISSION_PERCENT=1.0
GST_RATE_PERCENT=18.0
TDS_RATE_PERCENT=1.0

# ============================================================================
# AUCTION SETTINGS
# ============================================================================
# Extension Settings
DEFAULT_EXTENSION_TRIGGER_MINUTES=5
DEFAULT_EXTENSION_DURATION_MINUTES=5
MAX_AUCTION_EXTENSIONS=10

# Bid Validation
MIN_BID_INCREMENT_PERCENT=1.0  # 1% minimum increment
BID_RATE_LIMIT_PER_MINUTE=10   # Max 10 bids per minute per user

# ============================================================================
# WEBSOCKET SETTINGS
# ============================================================================
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MAX_CONNECTIONS_PER_USER=3

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5
LOG_FORMAT=json  # Options: json, text

# ============================================================================
# MONITORING & METRICS (optional)
# ============================================================================
PROMETHEUS_ENABLED=False
PROMETHEUS_PORT=9090

# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BID_PER_MINUTE=10

# ============================================================================
# TESTING (for development)
# ============================================================================
TESTING=False
TEST_DATABASE_URL=oracle+oracledb://test_user:test_pass@localhost:1521/XEPDB1

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_AUTO_BIDDING_ENABLED=True
FEATURE_BUY_NOW_ENABLED=True
FEATURE_DUTCH_AUCTION_ENABLED=False
FEATURE_WATCHLIST_ENABLED=True
FEATURE_RATINGS_ENABLED=True
