# ============================================================================
# SCRAPCY E-AUCTION - Environment Configuration
# Multi-Environment Setup (Local, Development, Staging, Production)
# ============================================================================

# ============================================================================
# ENVIRONMENT SELECTION
# ============================================================================
# Options: local, development, staging, production
APP_ENV=local

# Debug mode (auto-set based on environment)
DEBUG=True

# ============================================================================
# DATABASE CONFIGURATION (Environment-based)
# ============================================================================

# LOCAL DATABASE (for development/testing on your machine)
LOCAL_DATABASE_URL=oracle+oracledb://SCRAPCY_APP:your_local_password@localhost:1521/XEPDB1

# PRODUCTION DATABASE (Render or OCI)
PROD_DATABASE_URL=oracle+oracledb://SCRAPCY_APP:your_prod_password@prod-host:1521/your_service_name

# DEVELOPMENT/STAGING (optional)
# DEV_DATABASE_URL=oracle+oracledb://...
# STAGING_DATABASE_URL=oracle+oracledb://...

# ============================================================================
# SERVER URLS (Environment-based)
# ============================================================================

# LOCAL URLs (for testing on your machine)
LOCAL_BACKEND_URL=http://localhost:8000
LOCAL_FRONTEND_URL=http://localhost:3000

# PRODUCTION URLs (Render or OCI)
PROD_BACKEND_URL=https://scrapcy-backend.onrender.com
PROD_FRONTEND_URL=https://scrapcy.com

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://scrapcy.com

# ============================================================================
# SECURITY
# ============================================================================
SECRET_KEY=change-this-to-a-random-32-character-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# REDIS CONFIGURATION (Environment-based)
# ============================================================================

# LOCAL REDIS (for development)
LOCAL_REDIS_URL=redis://localhost:6379/0

# PRODUCTION REDIS (if using Redis Cloud or managed Redis)
# PROD_REDIS_URL=redis://username:password@your-redis-host:6379/0

REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10
REDIS_CACHE_TTL=3600

# ============================================================================
# FILE STORAGE (Environment-based)
# ============================================================================
# Options: local, google_sheets, s3, oci
STORAGE_PROVIDER=local

# Local Storage (for development)
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Google Sheets Storage (provide credentials when ready)
# GOOGLE_SHEETS_CREDENTIALS_FILE=/path/to/credentials.json
# GOOGLE_SHEETS_FOLDER_ID=your-google-drive-folder-id

# AWS S3 Storage
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=scrapcy-uploads

# OCI Object Storage (when you switch to OCI)
# OCI_NAMESPACE=your-namespace
# OCI_BUCKET=scrapcy-uploads
# OCI_REGION=ap-mumbai-1
# OCI_COMPARTMENT_ID=your-compartment-id

# ============================================================================
# PAYMENT GATEWAY - RAZORPAY (Environment-based)
# ============================================================================
RAZORPAY_ENABLED=False

# LOCAL/TEST Keys (for development)
LOCAL_RAZORPAY_KEY_ID=rzp_test_your_test_key
LOCAL_RAZORPAY_KEY_SECRET=your_test_secret

# PRODUCTION Keys (enable when deploying)
# PROD_RAZORPAY_KEY_ID=rzp_live_your_live_key
# PROD_RAZORPAY_KEY_SECRET=your_live_secret

RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
PAYMENT_CURRENCY=INR
PAYMENT_TIMEOUT_MINUTES=15

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
EMAIL_ENABLED=False
EMAIL_PROVIDER=sendgrid

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@scrapcy.com
EMAIL_FROM_NAME=SCRAPCY

# ============================================================================
# SMS CONFIGURATION (Optional)
# ============================================================================
SMS_ENABLED=False
SMS_PROVIDER=msg91

# MSG91
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=SCRPCY
MSG91_ROUTE=4
MSG91_TEMPLATE_ID_OTP=your-template-id

# ============================================================================
# OTP CONFIGURATION
# ============================================================================
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# ============================================================================
# VERIFICATION APIs (Optional)
# ============================================================================
GST_VERIFICATION_ENABLED=False
GST_API_KEY=your-gst-api-key

PAN_VERIFICATION_ENABLED=False
PAN_API_KEY=your-pan-api-key

# ============================================================================
# BACKGROUND SCHEDULER SETTINGS
# ============================================================================
SCHEDULER_ENABLED=True
AUCTION_CHECK_INTERVAL_SECONDS=30  # Production: 30s, Local: 60s (auto-adjusted)
NOTIFICATION_BATCH_SIZE=100

# ============================================================================
# COMMISSION SETTINGS
# ============================================================================
DEFAULT_SELLER_COMMISSION_PERCENT=2.0
DEFAULT_BUYER_COMMISSION_PERCENT=1.0
GST_RATE_PERCENT=18.0
TDS_RATE_PERCENT=1.0

# ============================================================================
# AUCTION SETTINGS
# ============================================================================
DEFAULT_EXTENSION_TRIGGER_MINUTES=5
DEFAULT_EXTENSION_DURATION_MINUTES=5
MAX_AUCTION_EXTENSIONS=10
MIN_BID_INCREMENT_PERCENT=1.0
BID_RATE_LIMIT_PER_MINUTE=10

# ============================================================================
# WEBSOCKET SETTINGS
# ============================================================================
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MAX_CONNECTIONS_PER_USER=3

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO  # Auto-adjusted: DEBUG (local), INFO (dev), WARNING (prod)

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=True  # Auto-disabled in local environment
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BID_PER_MINUTE=10

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_AUTO_BIDDING_ENABLED=True
FEATURE_BUY_NOW_ENABLED=True
FEATURE_WATCHLIST_ENABLED=True

# ============================================================================
# QUICK SETUP GUIDE
# ============================================================================
#
# FOR LOCAL TESTING:
# 1. Set APP_ENV=local
# 2. Configure LOCAL_DATABASE_URL with your local Oracle DB
# 3. Set STORAGE_PROVIDER=local
# 4. Keep RAZORPAY_ENABLED=False (or use test keys)
# 5. Run: uvicorn app.main:app --reload
#
# FOR PRODUCTION DEPLOYMENT (Render):
# 1. Set APP_ENV=production
# 2. Configure PROD_DATABASE_URL with your production DB
# 3. Set STORAGE_PROVIDER=s3 or google_sheets (provide credentials)
# 4. Set RAZORPAY_ENABLED=True with live keys
# 5. Configure PROD_BACKEND_URL and PROD_FRONTEND_URL
#
# FOR PRODUCTION DEPLOYMENT (OCI):
# 1. Set APP_ENV=production
# 2. Configure PROD_DATABASE_URL with OCI DB
# 3. Set STORAGE_PROVIDER=oci (provide OCI credentials)
# 4. Configure OCI_NAMESPACE, OCI_BUCKET, etc.
# 5. Update PROD_BACKEND_URL to your OCI instance IP
#
# ============================================================================
